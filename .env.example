# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# PostgreSQL connection string
DATABASE_URL=postgresql://traffic_user:CHANGE_ME@localhost:5432/traffic_db

# OpenAI API key (get it from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# LLM model to use (e.g. gpt-4o, gpt-4-turbo)
MODEL_NAME=gpt-4o

# API key for protecting TraffiQ endpoints.
# Generate a strong random value, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=CHANGE_ME
